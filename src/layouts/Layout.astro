---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styling/variables.css";
import "../styling/globalStyles.css";
export interface Props {
	title?: string;
	subtitle?: string;
}

const defaultTitle = "APS";
const { title = defaultTitle, subtitle } = Astro.props;
const formattedTitle = `${title}${subtitle ? ` | ${subtitle}` : ""}`;
const description =
	"Discover amateur palaeontology in Alberta and the society that supports it";
const ogImageUrl = new URL("/logos/aps-logo-black.png", Astro.url);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content={description}
		/>
		<meta
			name="keywords"
			content="Alberta Palaeontological Society, Southern Alberta, Alberta, Calgary, Palaeontology, Paleontology, Palaeontology, Fossil, Fossils, Dinosaurs, Dinosaur Hunting, Preservation, digs, Digging, Science, Geology, Meeting, Meetings, Guide to Vertebrate Fossils from the Cretaceous of Alberta, Vertebrate Fossils, Hope Johnson, Hope Johnson drawings, Invertebrate fossils, Plant fossils, Amateur Paleontology, Amateur Palaeontology, Fossil Club, Amateur Palaeontology"
		/>
		<meta name="last-modified" content={new Date().toUTCString()} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/logos/aps-logo.gif" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alberta Palaeontological Society" />
		<meta property="og:title" content={formattedTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Alberta Palaeontological Society logo" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1729" />
		<meta property="og:image:height" content="1729" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={formattedTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<script src="/scripts/calendarNav.js" defer />
		<title>{formattedTitle}</title>
	</head>
	<body>
		<Header />
		<div id="main">
			<main>
				<slot />
			</main>
		</div>
		<Footer />
	</body>
</html>
<style is:global>
	html {
		font-family: "Roboto", system-ui, sans-serif;
		line-height: 1.5;
		background-color: #f6f6f6;
		margin: 0;
		padding: 0;
		background-color: var(--background-colour-medium);
		color: var(--accent-colour-text);
		scroll-behavior: smooth;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
			DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
	}
	* {
		box-sizing: border-box;
	}
	body {
		min-height: 100vh;
		margin: 0;
		padding: 0;
	}
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: "Lexend Deca", system-ui, sans-serif;
		color: var(--accent-colour-medium);
	}
	#main {
		/* flex-grow: 1; */
		min-height: 100vh;
		display: flex;
		flex-direction: row;
		justify-content: center;
	}

	main {
		max-width: 1000px;
		padding: 1.5rem;
		overflow-x: auto;
	}
</style>
